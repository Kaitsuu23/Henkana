# Server Configuration
PORT=3000

# Target website base URL
BASE_URL=https://hentaicop.com

# CORS - gunakan * untuk allow semua origin, atau spesifik domain (pisah dengan koma)
CORS_ORIGIN=*

# Request timeout dalam milidetik
REQUEST_TIMEOUT=15000

# Maksimal retry ketika request gagal
MAX_RETRIES=3
